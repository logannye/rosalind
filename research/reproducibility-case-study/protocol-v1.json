{
  "schema_version": 1,
  "workload": "window-bam-sites",
  "contig": "chr20",
  "start": 10000000,
  "end": 11000000,
  "probes": 1000,
  "sample": "HG002",
  "profile": "shortread-dna-readcount-v1",
  "mapq": 20,
  "base_quality": 20,
  "counting_unit": "aligned read base; overlapping mates separate",
  "materialized_fields": "all",
  "materialized_mask": 63,
  "query_fields": "depths,alleles,strands",
  "native": {"budget_mib": 256, "workers": 1, "tile_bases": 16384, "max_read_len": 250, "max_record_bytes": 1048576},
  "oracle": {"tile_bases": 1024, "max_read_len": 250, "max_record_bytes": 1048576},
  "queries": [
    {"id": "Q1", "selection": "first 250", "alt": "original", "rows": 250, "thresholds": []},
    {"id": "Q2", "selection": "zero-based even indices", "alt": "second sorted non-REF base", "rows": 500, "thresholds": []},
    {"id": "Q3", "selection": "all", "alt": "original", "rows": 1000, "thresholds": [5, 10, 20]}
  ],
  "rounds": [["A", "B", "D"], ["B", "D", "A"], ["D", "A", "B"]],
  "parquet": {"compression": "zstd", "row_group_rows": 1024, "batch_rows": 1024, "shared_native_extraction": true},
  "rss_sample_interval_ms": 10,
  "prefix_boundary": "parent clock from worker launch through received verified-publication message for Qk",
  "setup_repeats": 1,
  "minimum_free_scratch_bytes": 21474836480,
  "minimum_available_ram_bytes": 8589934592,
  "bundle_limit_bytes": 134217728,
  "speed_gate": null,
  "source_lock": "benchmarks/giab/resources.tsv",
  "requirements": "research/cohort-reanalysis/workloads/requirements.lock"
}

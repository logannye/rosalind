# Rust
/target
# Build dirs for workspace members / the standalone wasm crate (wasm-pack).
**/target/
**/*.rs.bk
*.pdb

# Built wasm bundle for the in-browser receipt verifier (regenerated by
# scripts/build-wasm-verifier.sh).
/web/verify/pkg/

# Claims-harness output (regenerated by benchmarks/run.sh; records machine-dependent
# peak numbers — the asserted claims are portable, the file is not).
/benchmarks/results.json
# Cargo.lock IS tracked: rosalind ships a binary, so a pinned lockfile is part of
# the reproducible-build story behind the receipts (and stabilizes CI cache keys).

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Benchmarks
/benches/results/
/benchmarks/giab/data/

# Profiling
*.profdata
*.profraw

# Python
.venv/
__pycache__/
*.pyc

# Bundled demo data: a small reference.fa + alignments.bam are COMMITTED (so the
# README quickstart, the frontdoor test, and the release bundle work on a fresh
# clone); the large generated reads/SAM/VCF are regenerated by
# scripts/generate_toy_data.py and stay out of git.
examples/data/illumina_toy/*
!examples/data/illumina_toy/reference.fa
!examples/data/illumina_toy/alignments.bam

# Flagship demo: regenerated by scripts/flagship_ecoli_demo.sh (not committed).
/results/

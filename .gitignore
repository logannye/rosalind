# Bundled demo data: a small reference.fa + alignments.bam are COMMITTED (so the
# README quickstart, the frontdoor test, and the release bundle work on a fresh
# clone); the large generated reads/SAM/VCF are regenerated by
# scripts/generate_toy_data.py and stay out of git.
examples/data/illumina_toy/*
!examples/data/illumina_toy/reference.fa
!examples/data/illumina_toy/alignments.bam

# Flagship demo: regenerated by scripts/flagship_ecoli_demo.sh (not committed).
/results/
